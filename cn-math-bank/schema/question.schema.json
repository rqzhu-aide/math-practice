{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Harness Question 2.0",
  "type": "object",
  "required": ["ID", "Bank", "SchemaVersion", "ResponseType", "Language", "Question", "Choices", "Correct Answer", "Solution", "domain", "skill"],
  "properties": {
    "ID": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "Bank": {"type": "string"},
    "SchemaVersion": {"const": "2.0"},
    "ResponseType": {"enum": ["choice", "numeric", "short", "self"]},
    "GradingStatus": {"enum": ["gradable", "disputed"]},
    "GradingNote": {"type": "string", "minLength": 1},
    "Answer Form": {"enum": ["decimal", "standard-monomial", "ordered-list"]},
    "Language": {"enum": ["en", "zh-CN"]},
    "Year": {"type": ["integer", "null"]},
    "Grade": {"type": "integer"},
    "CurriculumUnit": {"type": "string"},
    "Level": {"type": "string"},
    "Batch": {"type": "string"},
    "Number": {"type": "integer", "minimum": 1},
    "Question": {"type": "string", "minLength": 1},
    "Question Type": {"enum": ["text", "mixed", "figure"]},
    "Choices Type": {"enum": ["text", "figure"]},
    "Choices": {"type": "object", "patternProperties": {"^[A-E]$": {"type": "string"}}, "additionalProperties": false},
    "Correct Answer": {"type": "string", "minLength": 1},
    "Accepted Answers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "Rejected Answers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "Unordered Answers": {"type": "boolean"},
    "Solution": {"type": "string"},
    "domain": {"type": "array", "items": {"type": "string", "pattern": "^domain:[a-z0-9-]+$"}, "uniqueItems": true},
    "skill": {"type": "array", "items": {"type": "string", "pattern": "^skill:[a-zA-Z0-9:_-]+$"}, "uniqueItems": true},
    "Meta": {"type": "object"}
  }
}
