  "Question": "What is the area ratio of two figures with a homothety ratio of \\(1:2\\)? Select one.",
  "Choices": {
    "A": "\\(1:2\\)",
    "B": "\\(1:8\\)",
    "C": "\\(1:4\\)",
    "D": "\\(1:3\\)"
