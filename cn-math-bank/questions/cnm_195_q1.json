  "Question": "Find the allowable values of $x$ in $y=\\sqrt{x+2}+1/(x-1)$.",
  "Choices": {
    "A": "$x\\ge-2$",
    "B": "$x\\ne1$",
    "C": "$x\\ge-2$ and $x\\ne1$",
    "D": "$x>-2$ and $x\\ne1$"
