    "A": "\\(\\{2x<6,\\ x+3>8\\}\\)",
    "B": "\\(\\{2x>6,\\ x+3>8\\}\\)",
    "C": "\\(\\{2x\\geq6,\\ x+3\\leq8\\}\\)",
    "D": "\\(\\{2x>6,\\ x+3<8\\}\\)"
  },
  "Correct Answer": "D",
