# Only the standalone harness, runtime, tests, and processed Chinese bank belong here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/Start Math Practice.cmd
!/math-practice/
!/scripts/
!/cn-math-bank/

/math-practice/*
!/math-practice/*.html
!/math-practice/*.css
!/math-practice/*.js
!/math-practice/config.example.json
!/math-practice/Start Math Practice.cmd
!/math-practice/vendor/
!/math-practice/test/

/scripts/*
!/scripts/serve_math_practice.py
!/scripts/launch_math_practice.py
!/scripts/connection_settings.py
!/scripts/student_assessment.py
!/scripts/model_connections.py
!/scripts/openai_connection.py
!/scripts/practice_tutor.py
!/scripts/question_answers.py
!/scripts/test_*.py

/cn-math-bank/*
!/cn-math-bank/bank.js
!/cn-math-bank/questions/
!/cn-math-bank/figures/
!/cn-math-bank/schema/
!/cn-math-bank/taxonomy/
!/cn-math-bank/LICENSE
!/cn-math-bank/NOTICE.md
!/cn-math-bank/README.md

# Never commit machine settings, credentials, sessions, or generated evidence.
config.json
config.tmp
config.local.*
settings.json
.env
.env.*
*.key
*.pem
*api_key*
auth.json
secrets.*
.local/
local/
__pycache__/
*.py[cod]
*.log
*.tmp
*.bak
*.backup
.DS_Store
Thumbs.db
.idea/
.vscode/
.codex/
.agents/
.impeccable/
.taste-skill/
node_modules/
.venv/
venv/
reports/
screenshots/

# AMC material and raw/processing work are intentionally outside this release.
amc-bank.js
*AMC*
question bank/
source/
staging/
translations/
architecture/
archived/
